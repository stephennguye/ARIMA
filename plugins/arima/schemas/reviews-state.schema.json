{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stephennguye/ARIMA/schemas/reviews-state.schema.json",
  "title": "Milestone reviews state",
  "description": ".arima/state/reviews.json: which milestone reviews are open or closed (WP-217). Written only by the milestone review module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviews"],
  "properties": {
    "schema_version": { "const": 1 },
    "reviews": {
      "type": "object",
      "propertyNames": { "pattern": "^MS-[0-9]{2,}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opened_at", "stories", "decisions"],
        "properties": {
          "opened_at": { "type": "string", "format": "date-time" },
          "closed_at": { "type": "string", "format": "date-time" },
          "stories": { "type": "array", "items": { "type": "string", "pattern": "^US-[0-9]+$" } },
          "decisions": {
            "type": "object",
            "description": "story id to the DEC id that carries its veto box",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
