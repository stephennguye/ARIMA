{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stephennguye/ARIMA/schemas/event.schema.json",
  "title": "Event",
  "description": "One line of .arima/events.jsonl: every state change and every guarded action (spec §11.3 Audit).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "type", "actor"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "run.start", "run.end", "run.paused",
        "preflight.fail", "killswitch.on", "killswitch.off",
        "id.issued",
        "notion.pull", "notion.push", "notion.conflict", "notion.refused",
        "item.status", "gate.opened", "gate.decided",
        "question.raised", "question.answered", "decision.made", "decision.vetoed",
        "tool.used", "tool.blocked",
        "state.push", "state.pull",
        "budget.alert", "hardstop.hit", "agent.stop",
        "report.accepted", "report.rejected", "unit.dispatched", "unit.retried",
        "merge.done", "merge.refused", "pr.published",
        "deploy.staging", "deploy.preview", "deploy.production", "deploy.rollback",
        "probe.recorded", "meeting.held", "digest.published",
        "phase.step_done", "phase.pilot_failed", "team.changed",
        "release.rc_tagged", "incident.opened", "incident.closed", "cr.decided", "lesson.applied"
      ]
    },
    "actor": { "type": "string", "description": "Role name, \"human:<person>\" or \"system\"" },
    "run_id": { "type": "string" },
    "item": { "type": "string" },
    "data": { "type": "object", "description": "Event-specific payload; never contains secrets" }
  }
}
