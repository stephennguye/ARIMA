{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stephennguye/ARIMA/schemas/arima.schema.json",
  "title": "arima.yaml",
  "description": "Project configuration for ARIMA (spec §4.1, §4.4). Draft for task T-02.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "profile", "autonomy", "schedule", "budget", "notion", "github", "environments", "runtime"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "client", "platforms", "docs_language"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z]{3,6}$" },
        "name": { "type": "string", "minLength": 1 },
        "client": { "type": "string", "minLength": 1, "description": "Client name, or \"internal\"" },
        "platforms": {
          "type": "array",
          "items": { "const": "web" },
          "minItems": 1,
          "maxItems": 1,
          "description": "Web only in v1.0 (D-33)"
        },
        "docs_language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "BCP-47 language for human-facing artifacts (D-22)" }
      }
    },
    "profile": { "enum": ["solo-lite", "client-project", "regulated"] },
    "stacks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": { "type": "string" },
        "backend": { "type": "string" }
      },
      "description": "Set by the architect at G2 (D-12); may be absent before G2"
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "question_policy", "hard_stops"],
      "properties": {
        "mode": { "enum": ["assisted", "gated", "autonomous"] },
        "question_policy": { "enum": ["block_story", "assume_and_log"] },
        "hard_stops": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["G0", "G1", "G2", "G3", "G4", "prod_deploy", "secrets_change", "budget_exceeded", "story_budget", "notion_delete", "prod_data_migration", "new_paid_service", "licence", "critical_finding", "kill_switch", "missing_credential"]
          },
          "allOf": [
            { "contains": { "const": "prod_deploy" } },
            { "contains": { "const": "secrets_change" } },
            { "contains": { "const": "notion_delete" } }
          ],
          "description": "prod_deploy, secrets_change and notion_delete can never be removed (§11.1)"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "daily_run", "digest_ready_by", "max_run_minutes"],
      "properties": {
        "timezone": { "type": "string", "minLength": 3 },
        "daily_run": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "digest_ready_by": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "max_run_minutes": { "type": "integer", "minimum": 10, "maximum": 1440 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "project_cap", "daily_cap", "per_story_default", "per_run_cap", "alert_thresholds"],
      "properties": {
        "currency": { "const": "USD" },
        "project_cap": { "type": "number", "exclusiveMinimum": 0 },
        "daily_cap": { "type": "number", "exclusiveMinimum": 0 },
        "per_story_default": { "type": "number", "exclusiveMinimum": 0 },
        "per_run_cap": { "type": "number", "exclusiveMinimum": 0 },
        "by_size": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "S": { "type": "number", "exclusiveMinimum": 0 },
            "M": { "type": "number", "exclusiveMinimum": 0 },
            "L": { "type": "number", "exclusiveMinimum": 0 }
          },
          "description": "Default story budgets by size (D-25): S 1, M 3, L 6"
        },
        "alert_thresholds": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "minItems": 1
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strong": { "type": "string" },
            "standard": { "type": "string" },
            "fast": { "type": "string" }
          }
        },
        "by_role": {
          "type": "object",
          "additionalProperties": { "enum": ["strong", "standard", "fast"] },
          "propertyNames": { "enum": ["orchestrator", "ba", "ux", "architect", "tech_lead", "developer", "qa", "security", "devops"] }
        }
      }
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_developer_agents": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_prs_awaiting_human": { "type": "integer", "minimum": 1, "default": 5, "description": "D-21" }
      }
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_page_id", "token_env"],
      "properties": {
        "root_page_id": { "type": "string", "minLength": 1 },
        "token_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "default_branch", "state_branch"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "default_branch": { "type": "string" },
        "state_branch": { "type": "string" },
        "allow_unchecked_remote": { "type": "boolean", "default": false, "description": "Let the publish script push to a remote that is not a github.com repository (ARIMA cannot check what it is). Leave false unless you know the remote." },
        "allow_public_state": { "type": "boolean", "default": false, "description": "Allow pushing the state branch (Notion mirror, ledger) to a PUBLIC GitHub repo. Leave false for client work." },
        "machine_account": { "type": "string", "description": "GitHub login that opens agent PRs (D-30)" },
        "machine_token_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging", "production"],
      "properties": {
        "staging": { "$ref": "#/$defs/environment" },
        "production": {
          "allOf": [
            { "$ref": "#/$defs/environment" },
            { "type": "object", "properties": { "deploy": { "const": "gated" } } }
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "shell", "scheduler", "auth", "allow_usage_credits"],
      "properties": {
        "host": { "enum": ["local", "github-actions"] },
        "shell": { "enum": ["wsl2", "native"] },
        "scheduler": { "enum": ["windows-task-scheduler", "cron", "github-actions"] },
        "auth": { "enum": ["seat", "api_key"] },
        "allow_usage_credits": { "type": "boolean" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otel_enabled": { "type": "boolean" },
        "endpoint_env": { "type": "string" }
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "deploy"],
      "properties": {
        "url": { "type": "string" },
        "deploy": { "enum": ["auto", "gated"] }
      }
    }
  }
}
